services:
  redis:
    image: redis
    container_name: redis
    ports:
      - 6379:6379

  monitor_metric:
    build:
      context: .
      dockerfile: Dockerfile_monitor
      args:
        COWRIE_USER_ID: ${COWRIE_USER_ID}
        COWRIE_GROUP_ID: ${COWRIE_GROUP_ID}
        DOCKER_GROUP_ID: ${DOCKER_GROUP_ID}
    image: monitor_metric
    user: ${COWRIE_USER}
    #depends_on:
    #  - redis
    command: ['python', 'metric.py']
    container_name: monitor_metric
    volumes:
      - ./config.ini:/monitor/monitor/config.ini
      - /var/run/docker.sock:/var/run/docker.sock
      - ./log:/monitor/log

  monitor_process:
    build:
      context: .
      dockerfile: Dockerfile_monitor
      args:
        COWRIE_USER_ID: ${COWRIE_USER_ID}
        COWRIE_GROUP_ID: ${COWRIE_GROUP_ID}
        DOCKER_GROUP_ID: ${DOCKER_GROUP_ID}
    image: monitor_process
    privileged: true
    #user: ${COWRIE_USER}
    #depends_on:
    #  - redis
    command: ['python', 'process.py']
    container_name: monitor_process
    volumes:
      - ./config.ini:/monitor/monitor/config.ini
      - /var/run/docker.sock:/var/run/docker.sock
      - ./log:/monitor/log
      - /proc:/var/lib/proc
      - ./data_monitor/ignored_digest.txt:/monitor/monitor/ignored_digest.txt
      - ./data_monitor/not_saved_digest.txt:/monitor/monitor/not_saved_digest.txt
      - ./data_monitor/exe:/monitor/monitor/exe

networks:
  default:
      external: true
      name: cowrie_default
