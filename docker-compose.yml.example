version: '3.6'

services:
  monitor_metric:
    build:
      context: .
      dockerfile: Dockerfile_monitor
      args:
        COWRIE_USER_ID: ${COWRIE_USER_ID}
        COWRIE_GROUP_ID: ${COWRIE_GROUP_ID}
        DOCKER_GROUP_ID: ${DOCKER_GROUP_ID}
    user: ${COWRIE_USER}
    image: monitor_metric
    command: ['python', 'metric.py']
    container_name: monitor_metric
    volumes:
      - ./config.ini:/monitor/monitor/config.ini
      - /var/run/docker.sock:/var/run/docker.sock
      - ./log:/monitor/log

  monitor_process:
    build:
      context: .
      dockerfile: Dockerfile_monitor
      args:
        COWRIE_USER_ID: ${COWRIE_USER_ID}
        COWRIE_GROUP_ID: ${COWRIE_GROUP_ID}
        DOCKER_GROUP_ID: ${DOCKER_GROUP_ID}
    user: ${COWRIE_USER}
    image: monitor_process
    command: ['python', 'process.py']
    container_name: monitor_process
    volumes:
      - ./config.ini:/monitor/monitor/config.ini
      - /var/run/docker.sock:/var/run/docker.sock
      - ./log:/monitor/logs

networks:
  default:
      external: true
      name: cowrie_default